{{- /* RSS: only articles (type "posts"), newest first, with summary + link. */ -}}
{{- $pages := cond (eq .Kind "home") (where site.RegularPages "Type" "posts") .Pages | first 50 -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} | {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.LanguageCode }}</language>
    {{- with $pages }}<lastBuildDate>{{ (index (sort . "Lastmod" "desc") 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Params.description | default (.Summary | plainify | truncate 300) }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
