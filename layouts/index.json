{{- $out := slice }}
{{- range where site.RegularPages "Type" "posts" }}
  {{- $out = $out | append (dict
    "title" .Title
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
    "description" (.Params.description | default (.Summary | plainify | truncate 200))
    "categories" (.Params.categories | default slice)
    "tags" (.Params.tags | default slice)
    "content" (.Plain | truncate 2000)) }}
{{- end }}
{{- $out | jsonify }}
